# Contoh variabel lingkungan (isi nilainya di Vercel → Settings → Environment Variables).
# JANGAN menaruh nilai asli di file yang ke-commit ke GitHub.

# Connection string dari Neon (Bagian A2)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Project id Firebase
FIREBASE_PROJECT_ID=aston-cirebon

# Seluruh isi serviceAccountKey.json (satu baris/JSON penuh) untuk verifikasi token login
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"aston-cirebon", ... }
